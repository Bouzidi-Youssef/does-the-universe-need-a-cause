---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import Sidebar from '../components/Sidebar.astro';
import ProgressBar from '../components/ProgressBar.astro';

interface Props {
  title?: string;
}

const { title = 'Does the Universe Need a Cause?' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;1,300;1,400&family=Space+Grotesk:wght@300;400;500&family=Space+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Sidebar />
    <ProgressBar />
    <div id="main">
      <slot />
    </div>
    <script src="../scripts/scroll-spy.ts"></script>
  </body>
</html>
