---
interface Props {
  accent?: 'green' | 'gold' | 'red';
  label: string;
  title: string;
  body: string;
  note?: string;
}

const { accent = 'gold', label, title, body, note } = Astro.props;

const border =
  accent === 'green'
    ? 'rgba(74,171,122,0.3)'
    : accent === 'red'
      ? 'rgba(201,107,91,0.3)'
      : 'rgba(201,166,107,0.35)';

const labelColor = accent === 'green' ? 'var(--green)' : accent === 'red' ? 'var(--red)' : 'var(--accent)';
---
<div class="hypo-card" style={`border-color:${border};`}>
  <div class="hypo-label" style={`color:${labelColor};`}>{label}</div>
  <div class="hypo-title">{title}</div>
  <div class="hypo-body">{body}</div>
  {note && <div class="hypo-note">→ {note}</div>}
</div>
